      "id": "business_model",
      "title": "Business model",
      "category": "business_model",
      "blocks": [
        {
          "type": "text",
          "title": "Operations and route to market",
          "text": "Micron manufactures at wholly owned facilities and uses subcontractors for certain processes; it sells products through business units into markets in forms including components, modules, SSDs, managed NAND, multi-chip packages, and wafers.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_mu_10q",
            "quote": "We manufacture our products at wholly-owned facilities and also utilize subcontractors for certain manufacturing processes."
          }
        },
        {
          "type": "text",
          "title": "Technology and operating priorities",
          "text": "The filing describes investment in proprietary product and process technology, with an aim to increase bit density per wafer and reduce per-bit manufacturing costs.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_mu_10q",
            "quote": "which generally increases bit density per wafer and reduces per-bit manufacturing costs"
          }
        },
        {
          "type": "text",
          "title": "System-level offerings",
          "text": "Some system-level solutions combine NAND, a controller, firmware, and sometimes DRAM.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_mu_10q",
            "quote": "Many of our system-level solutions combine NAND, a controller, firmware, and in some cases DRAM."
          }
        }
      ]
    },
