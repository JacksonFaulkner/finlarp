      "id": "business_model",
      "title": "Business model",
      "category": "business_model",
      "blocks": [
        {
          "type": "text",
          "title": "Revenue model",
          "text": "Subscription and support revenue accounted for substantially all revenue in the three and six months ended June 30, 2026 and 2025. The filing describes customers contracting to use the company’s global network and products.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_net_10q",
            "quote": "Subscription and support revenue is recognized over time and accounted for substantially all of the Company’s revenue"
          }
        }
      ]
    },
    {
      "id": "products_applications",
      "title": "Products and applications",
      "category": "products",
      "blocks": [
        {
          "type": "text",
          "title": "Company-described capabilities",
          "text": "The CEO described Cloudflare as building infrastructure, controls, developer tools, and payment rails for the Agentic Internet. These are described capabilities, not a product list.",
          "status": "reported",
          "evidence": {
            "source_id": "net_results_1",
            "quote": "building the infrastructure, controls, developer tools, and payment rails for the Agentic Internet."
          }
        },
        {
          "type": "text",
          "title": "Application areas",
          "text": "The filing identifies security, performance, and reliability as areas of product and solution demand; it does not enumerate specific products in the supplied excerpt.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_net_10q",
            "quote": "the demand, and our ability to generate demand, for our products or for solutions for security, performance, and reliability in general"
          }
        }
      ]
    },
