          "type": "text",
          "title": "Operating model",
          "text": "Oracle reports three businesses—cloud and software, hardware, and services—each comprising a single operating segment. Its offerings are delivered through cloud, on-premise, and hybrid deployment models.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_orcl_10q",
            "quote": "We have three businesses: cloud and software; hardware; and services; each of which is comprised of a single operating segment."
          }
