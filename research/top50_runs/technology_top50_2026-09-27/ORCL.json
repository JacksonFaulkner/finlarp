              "cells": [
                "Cloud",
                "Subscription access to cloud applications and infrastructure; revenue generally recognized over the contract or as services are consumed."
              ],
              "status": "reported",
              "evidence": {
                "source_id": "sec_orcl_10q",
                "quote": "are recognized as revenues ratably over the contractual period of the cloud contract or, in the case of usage model contracts, as the cloud services are consumed over time"
              }
            },
