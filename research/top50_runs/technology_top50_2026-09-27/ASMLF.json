      "blocks": [
        {
          "type": "text",
          "title": "How ASML describes its business",
          "text": "ASML supplies lithography systems and related capabilities to semiconductor manufacturers. Its offering combines systems with computational modeling, metrology, inspection, and customer support.",
          "status": "reported",
          "evidence": {
            "source_id": "asmlf_business_1",
            "quote": "we provide our customers with everything they need to mass produce microchip patterns on silicon wafers. Our holistic approach integrates computational modeling, optical metrology and e-beam inspection with lithography systems"
          }
        }
      ]
