      "id": "business_model",
      "title": "Business model",
      "category": "business_model",
      "blocks": [
        {
          "type": "text",
          "title": "Products and manufacturing",
          "text": "Intel Products sells semiconductor products based on Intel architecture. Intel Foundry provides wafer fabrication, substrates, and related products and services, primarily to Intel’s internal businesses, and also reports some external-customer foundry and assembly-and-test revenue.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_intc_10q",
            "quote": "Segment revenue: consists substantially of intersegment product and services revenue for wafer fabrication, substrates and other related products and services sold to Intel Products"
          }
        },
        {
          "type": "text",
          "title": "Organization",
          "text": "The filing identifies CCPG, DCAI, and Intel Foundry as reportable operating segments; All Other is not a reportable segment.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_intc_10q",
            "quote": "CCPG, DCAI and Intel Foundry are our reportable operating segments."
          }
        },
        {
          "type": "text",
          "title": "Strategy",
          "text": "Intel describes a strategy of broadening beyond CPUs toward multi-architecture xPU platforms and a modern IDM model.",
          "status": "reported",
          "evidence": {
            "source_id": "intc_business_1",
            "quote": "transforming from a CPU to a multi-architecture xPU company, from silicon to platforms, and from a traditional IDM to a new, modern IDM."
          }
        }
      ]
    },
    {
