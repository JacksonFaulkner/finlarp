    {
      "id": "drivers_risks",
      "title": "Drivers and risks",
      "category": "risks",
      "blocks": [
        {
          "type": "text",
          "title": "Reported drivers",
          "text": "Intel reported Q2 revenue of $16.1 billion, up 25% year over year, and cited robust demand, improved execution, higher factory yields, and improved cycle times.",
          "status": "reported",
          "evidence": {
            "source_id": "intc_results_1",
            "quote": "Second-quarter revenue was $16.1 billion, up 25% year-over-year (YoY)."
          }
        },
        {
          "type": "text",
          "title": "Manufacturing investment and execution risk",
          "text": "The filing identifies long-term, risky R&D and manufacturing investments and the complexity and uncertainty of developing and implementing new products and process technologies.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_intc_10q",
            "quote": "The significant, long-term and inherently risky investments we are making in R&D and manufacturing facilities that may not realize a favorable return"
          }
        },
        {
          "type": "text",
          "title": "Demand and supply-chain risks",
          "text": "The filing identifies changing product demand, global supply-chain disruption, trade tensions, and industry-wide substrate and memory shortages as risks.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_intc_10q",
            "quote": "including current industry-wide substrate and memory shortages"
          }
        },
        {
          "type": "text",
          "title": "Additional market risks",
          "text": "The filing also identifies the evolving market for products with AI capabilities and customer concentration and third-party distribution as risk areas.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_intc_10q",
            "quote": "sales-related risks, including customer concentration and the use of distributors and other third parties"
          }
        }
      ]
    }
