        {
          "type": "text",
          "title": "Software and features announced",
          "text": "In the third quarter of 2026, Apple announced iOS 27, macOS 27 Golden Gate, iPadOS 27, watchOS 27, visionOS 27 and tvOS 27, and introduced Siri AI.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_aapl_10q",
            "quote": "During the third quarter of 2026, the Company announced iOS 27, macOS® 27 Golden Gate, iPadOS® 27, watchOS® 27, visionOS® 27 and tvOS® 27, and introduced Siri AI."
          }
        },
        {
          "type": "text",
          "title": "Enterprise applications",
          "text": "Apple describes its enterprise offering as supporting employee connection, collaboration and creativity, alongside IT management and device deployment.",
          "status": "reported",
          "evidence": {
            "source_id": "aapl_business_1",
            "quote": "Apple hardware, software, and services work together to supercharge connection, collaboration, and creativity. Employees can do incredible things, IT can handle it all, and businesses can break new ground."
          }
        }
