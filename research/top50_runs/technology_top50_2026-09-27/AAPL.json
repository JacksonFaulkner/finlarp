        {
          "type": "text",
          "title": "Component and compute supply risk",
          "text": "Apple reports supply constraints and increasing costs for components, including advanced semiconductors, NAND storage and DRAM memory, and warns these trends may materially negatively affect revenue, costs, gross margin, results and financial condition. It also identifies constrained, higher-cost cloud and AI computing capacity as a risk.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_aapl_10q",
            "quote": "The Company is experiencing a period of supply constraints and increasing costs for components driven by factors such as industry supply-demand imbalances for components, including advanced semiconductors, storage (NAND) and memory (DRAM)."
          }
        },
        {
          "type": "text",
          "title": "Tariff and regulatory risk",
          "text": "The filing says tariff effects remain uncertain and may adversely affect the supply chain, component availability, pricing and gross margin. It also describes litigation and regulatory risks affecting App Store commissions and distribution.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_aapl_10q",
            "quote": "Tariffs and other measures that are applied to the Company’s products or their components can have a material adverse impact on the Company’s business, results of operations and financial condition, including impacting the Company’s supply chain, the availability of rare earths and other raw materials and components, pricing and gross margin."
          }
        }
