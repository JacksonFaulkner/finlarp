      "title": "Business model",
      "category": "business_model",
      "blocks": [
        {
          "type": "text",
          "title": "Reported operating model",
          "text": "Apple uses outsourcing partners to manufacture subassemblies and perform final assembly and testing; it also obtains product components from a wide variety of suppliers.",
          "status": "reported",
          "evidence": {
            "source_id": "sec_aapl_10q",
            "quote": "The Company utilizes several outsourcing partners to manufacture subassemblies for the Company’s products and to perform final assembly and testing of finished products. The Company also obtains individual components for its products from a wide variety of individual suppliers."
          }
        }
      ]
