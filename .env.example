# Copy to .env (gitignored). Read by sources/keys.py, and passed to scripts
# by nvim via `uv run --env-file .env`.

# E*TRADE OAuth (sandbox + production consumer keys)
CONSUMER_KEY=
CONSUMER_SECRET=
PROD_KEY=
PROD_SECRET=
ETRADE_API_KEY=
ETRADE_API_SECRET=

# USPTO Open Data Portal (patents bulk + file wrappers)
USPTO_API_KEY=

# jobs/report_top50.py
OPENAI_API_KEY=
EXA_API_KEY=

# required for SEC requests: contact email sent in the User-Agent
SEC_CONTACT=

# optional: SEC requests/second per process (default 1.5; SEC's cap is 10 across all)
# SEC_RPS=1.5
