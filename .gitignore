# any env file (.env, .env.local, foo.env); commit only the template
.env*
*.env
!.env.example
.envrc
# pbr3d run log (observe.py): this machine's timings, not for git
tools/pbr3d/runs.jsonl
# terraform: tfvars hold secret values; state holds them too
terraform/*.tfvars
*.tfstate
*.tfstate.*
.terraform/
.venv/
__pycache__/
*.pyc
.ruff_cache/
.DS_Store
*.log
.pytest_cache/
.mypy_cache/
*.duckdb
*.duckdb.wal
*.sqlite
*.db
# local datasets and scratch notes; not published
data/
research/
# third-party video transcripts (same as video/, excluded locally)
docs/transcripts/
# per-machine Claude Code settings
.claude/settings.local.json

# generated render output (frames and videos from the showcase scripts)
artifacts/

# pbr3d Blender outputs: GLB scenes and .blend sources sync from S3, not git
*.glb
*.blend
*.blend1
tools/pbr3d/assets/fonts/
# per-machine window layout dumps
jackwitapack_screen_*.json
